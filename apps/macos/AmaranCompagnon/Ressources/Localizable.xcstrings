    },
    " : par le réseau, le pont ne les envoie que sur demande ; les courbes d'annonces, de NetMIC faux et de refus ne reçoivent plus de point." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ": over the network, the bridge only sends them on request; the advertisement, bad NetMIC, and refusal charts no longer receive points."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " : par le réseau, le pont ne les envoie que sur demande ; les courbes d'annonces, de NetMIC faux et de refus ne reçoivent plus de point."
          }
        }
      }
    },
