    " (dernier relevé à %@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (last readout at %@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
