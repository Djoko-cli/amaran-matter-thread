// Signature de l'app et des tests (repris de Halo Compagnon).
// Par defaut : ad hoc (le depot compile partout, sans compte Apple). Les versions publiees
// sont signees par le certificat auto-signe de Djoko, `Djoko-cli Code Signing` (Outils/publier.sh,
// spec du deploiement, section 2). Pour que le trousseau et le dossier d'amaran Desktop autorise
// tiennent d'une compilation a l'autre, et soient partages avec la version installee, signer les
// compilations de travail avec le meme certificat : creer Local.xcconfig (ignore par git) avec
//   CODE_SIGN_IDENTITY = Djoko-cli Code Signing
//   DEVELOPMENT_TEAM =
// (au premier codesign, macOS demande l'acces a la cle du certificat : « Toujours autoriser »).
// Icone : AppIcon (M2, le A d'amaran redessine, celle des versions publiees) ; AppIconA2 (la constellation)
// reste en repli, choisie par ASSETCATALOG_COMPILER_APPICON_NAME = AppIconA2.
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
// Runtime durci : coupe pour les compilations de travail. Sans equipe (ad hoc, ou le certificat
// auto-signe), la validation des bibliotheques refuserait de charger AmaranProtocole.framework et
// Sparkle. Les versions publiees l'ont, avec la levee de cette validation pour l'app seule
// (Outils/publication.py).
ENABLE_HARDENED_RUNTIME = NO
#include? "Local.xcconfig"
